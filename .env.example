# SouqIQ — Environment Variables
# Never commit `.env`.

# ── Database (Supabase PostgreSQL) ──────────────────────────
# From Supabase → Project Settings → Database → Connection string
#
# DATABASE_URL = Transaction pooler (port 6543) — used by the app on Vercel
# DIRECT_URL   = Direct / Session (port 5432) — used by Prisma migrations
#
# Example (replace PASSWORD and project ref):
# DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/souqiq?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/souqiq?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="generate-a-long-random-secret"
# Local:
AUTH_URL="http://localhost:3000"
# Production (Vercel):
# AUTH_URL="https://souqiq.vercel.app"

# Resend (optional — admin order emails)
RESEND_API_KEY="re_xxxxxxxx"
ADMIN_NOTIFICATION_EMAIL="admin@example.com"
EMAIL_FROM="SouqIQ <orders@your-domain.com>"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="SouqIQ"
NEXT_PUBLIC_WHATSAPP_NUMBER="+9647XXXXXXXXX"

# Supabase Storage (admin product image uploads)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
