# SouqIQ — Environment Variables
# Copy to `.env` and fill in real values. Never commit `.env`.

# PostgreSQL connection string
# Local example: postgresql://USER:PASSWORD@localhost:5432/souqiq?schema=public&sslmode=verify-full
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/souqiq?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="generate-a-long-random-secret"
# Optional in production:
# AUTH_URL="https://your-domain.com"

# Resend (Phase 8 — admin order emails)
RESEND_API_KEY="re_xxxxxxxx"
ADMIN_NOTIFICATION_EMAIL="admin@example.com"
EMAIL_FROM="SouqIQ <orders@your-domain.com>"

# Used in admin email deep links (optional; falls back to AUTH_URL / localhost)
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Public storefront
NEXT_PUBLIC_APP_NAME="SouqIQ"
NEXT_PUBLIC_WHATSAPP_NUMBER="+9647XXXXXXXXX"
